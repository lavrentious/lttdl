# lttdl example configuration
# copy to production.env (or development.env) and fill in the required values

# ── required ──────────────────────────────────────────────────────────────────

NODE_ENV=production
BOT_TOKEN=your_telegram_bot_token_here

# ── local paths. defaults are ok, tweak if you want ──────────────────────────

TEMP_DIR=./tmp
DB_PATH=./data/app.db

# netscape-format cookies file for age/geo-restricted content (yt-dlp only)
# export from your browser with a cookies.txt extension
# YT_DLP_COOKIES_PATH=./cookies.txt

# ── rate limiting. defaults are ok, modify with caution ──────────────────────

# BOT_USER_JOB_RATE_LIMIT_PER_MINUTE=10
# BOT_USER_JOB_RATE_LIMIT_PER_DAY=50
# BOT_USER_JOB_RATE_LIMIT_MINUTE_WINDOW_MS=60000
# BOT_USER_JOB_RATE_LIMIT_DAY_WINDOW_MS=86400000

# ── bot behavior. defaults are ok, change if needed ──────────────────────────

# BOT_PROGRESS_UPDATE_INTERVAL_MS=1200
# BOT_MAX_ACTIVE_JOBS_PER_USER=4
# BOT_MUSIC_PAGE_SIZE=5
# BOT_MUSIC_SEARCH_LIMIT=20
# BOT_MUSIC_SEARCH_TTL_MS=600000
# BOT_MAX_FILE_SIZE_MB=50

# ── yt-dlp behavior. defaults seem ok, you probably shouldn't touch this (unless needed) ──

# YT_DLP_CONCURRENT_FRAGMENTS=4
# YT_DLP_YOUTUBE_METADATA_TIMEOUT_MS=30000
# YT_DLP_YOUTUBE_DOWNLOAD_TIMEOUT_MS=1200000
# YT_DLP_MUSIC_SEARCH_TIMEOUT_MS=120000
# YT_DLP_MUSIC_METADATA_TIMEOUT_MS=30000
# YT_DLP_MUSIC_DOWNLOAD_TIMEOUT_MS=1200000
# YT_DLP_THUMBNAIL_FETCH_TIMEOUT_MS=15000
# YT_DLP_MUSIC_SEARCH_REMOTE_COMPONENTS=ejs:github

# ── network retry knobs. you shouldn't touch this (unless needed) ─────────────

# NETWORK_FETCH_INFO_TIMEOUT_MS=15000
# NETWORK_FETCH_INFO_RETRIES=1
# NETWORK_RETRY_DELAY_MS=300
# ASSET_FILE_DOWNLOAD_TIMEOUT_MS=45000
# ASSET_FILE_DOWNLOAD_RETRIES=1

# ── media processing timeouts. you REALLY shouldn't touch this (unless needed) ──

# VIDEO_FFPROBE_TIMEOUT_MS=15000
# VIDEO_FFMPEG_TIMEOUT_MS=600000
# IMAGE_PROCESS_TIMEOUT_MS=15000

# ── file sharing. off by default; configure to enable ────────────────────────
# when enabled the bot copies each downloaded file to FILE_SHARE_DIR and sends
# the user a direct download link. two server modes are available:
#
#   proxy   — you serve FILE_SHARE_DIR yourself (nginx, caddy, etc.)
#             see docs/nginx-file-share.conf for a sample nginx config
#
#   builtin — the bot runs a built-in http server on FILE_SHARE_SERVER_PORT.
#             you can still put nginx in front as a reverse proxy.

# FILE_SHARE_ENABLED=false
# FILE_SHARE_BASE_URL=https://example.com/files
# FILE_SHARE_DIR=./shared
# FILE_SHARE_TTL_S=3600              # how long shared files are kept (seconds)
# FILE_SHARE_CLEANUP_INTERVAL_S=300  # how often expired files are purged (seconds)
# FILE_SHARE_MAX_DIR_SIZE_MB=0       # storage cap for FILE_SHARE_DIR in MB; 0 = no limit
# FILE_SHARE_SERVER_MODE=proxy
# FILE_SHARE_SERVER_PORT=3000
